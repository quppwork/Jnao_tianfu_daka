<template>
  <view class="login-page">
    <scroll-view class="login-scroll" scroll-y :show-scrollbar="false">
      <view class="login-viewport" :style="{ minHeight: viewportHeight + 'px', paddingTop: topInset + 'px', paddingBottom: bottomInset + 'px' }">
        <image class="glow glow-top" src="/static/login/glow-top.png" mode="aspectFit" />
        <image class="glow glow-bottom" src="/static/login/glow-bottom.png" mode="aspectFit" />
        <view class="login-card">
          <view class="brand-head">
            <view class="logo-row">
              <text class="logo-j">J</text><text class="logo-nao">nao</text><text class="logo-ai">AI</text>
            </view>
            <text class="subtitle">{{ registering ? (role == 'student' ? '注册学生账号' : '注册家长账户') : '欢迎来到天赋成长平台' }}</text>
            <text v-if="!registering" class="sub-desc">天赋测评 · 每日训练 · 成长记录</text>
          </view>

          <form :class="registering ? 'register-main' : 'login-main'" @submit="submit">
            <view v-if="!registering" class="role-row">
              <view class="role-item role-student" :class="{ 'role-active': role == 'parent' }" @click="openLogin('parent')">
                <text class="role-label" :class="{ 'role-label-active': role == 'parent' }">家长</text>
                <view v-if="role == 'parent'" class="role-underline"></view>
              </view>
              <view class="role-item" :class="{ 'role-active': role == 'student' }" @click="openLogin('student')">
                <text class="role-label" :class="{ 'role-label-active': role == 'student' }">学生</text>
                <view v-if="role == 'student'" class="role-underline"></view>
              </view>
            </view>

            <!-- 家长注册专属字段 -->
            <template v-if="registering && role == 'parent'">
              <view class="input-wrap">
                <input v-model="realName" class="login-input" :maxlength="20" placeholder="真实姓名（必填）" :disabled="submitting" />
              </view>
              <view class="input-wrap">
                <input v-model="nickname" class="login-input" :maxlength="20" placeholder="昵称（必填）" :disabled="submitting" />
              </view>
            </template>

            <!-- 账号 / 手机号 -->
            <view v-if="role == 'parent'" class="input-wrap">
              <input v-model="phone" class="login-input" name="phone" type="number" :maxlength="11" autocomplete="tel" :disabled="submitting || sendingSms" :placeholder="registering ? '手机号' : '注册手机号（11位，非昵称）'" />
            </view>
            <view v-else class="input-wrap">
              <input v-model="loginName" class="login-input" name="username" :maxlength="50" autocomplete="username" :disabled="submitting" :placeholder="registering ? '学生登录账号（2-50位）' : '孩子账号'" />
            </view>

            <!-- 学生注册专属字段 -->
            <template v-if="registering && role == 'student'">
              <view class="input-wrap">
                <input v-model="realName" class="login-input" :maxlength="20" placeholder="学生姓名（必填）" :disabled="submitting" />
              </view>
              <view class="input-wrap">
                <input v-model="nickname" class="login-input" :maxlength="20" placeholder="展示昵称（选填）" :disabled="submitting" />
              </view>
              <view class="input-wrap">
                <picker class="login-picker" mode="date" :value="birthDate.length > 0 ? birthDate : defaultBirthDate" start="1990-01-01" :end="todayDate" :disabled="submitting" @change="onBirthDateChange">
                  <text class="picker-value" :class="{ 'picker-placeholder': birthDate.length == 0 }">{{ birthDate.length > 0 ? '出生日期：' + birthDate : '请选择出生日期（必填）' }}</text>
                </picker>
              </view>
              <view class="input-wrap">
                <picker class="login-picker" :range="gradeOptions" :value="gradeIndex" :disabled="submitting" @change="onGradeChange">
                  <text class="picker-value" :class="{ 'picker-placeholder': grade.length == 0 }">{{ grade.length > 0 ? '年级：' + grade : '请选择年级（选填）' }}</text>
                </picker>
              </view>
              <view class="input-wrap" @click="openRegionPicker">
                <text class="picker-value" :class="{ 'picker-placeholder': regionDisplay.length == 0 }">{{ regionDisplay.length > 0 ? '所在地区：' + regionDisplay : '请选择所在地区（选填）' }}</text>
              </view>
              <view class="input-wrap">
                <input v-model="school" class="login-input" :maxlength="50" placeholder="学校名称（选填）" :disabled="submitting" />
              </view>
            </template>

            <!-- 家长短信验证码 -->
            <view v-if="role == 'parent' && (useSms || registering)" class="input-wrap sms-row">
              <input v-model="smsCode" class="login-input" name="code" type="number" :maxlength="8" autocomplete="one-time-code" :disabled="submitting" placeholder="短信验证码" />
              <button class="sms-btn" :disabled="submitting || sendingSms || waitSeconds > 0" @click="openCaptcha">{{ waitSeconds > 0 ? waitSeconds.toString() + 's' : '获取验证码' }}</button>
            </view>

            <!-- 密码与确认密码 -->
            <view v-if="!(role == 'parent' && useSms && !registering)" class="input-wrap">
              <input v-model="password" class="login-input" name="password" password :autocomplete="registering ? 'new-password' : 'current-password'" :disabled="submitting" :maxlength="registering ? 32 : 128" :placeholder="registering ? '登录密码（8-32位，含大小写+数字）' : '密码'" confirm-type="done" @confirm="submit" />
            </view>
            <view v-if="registering" class="input-wrap">
              <input v-model="confirmPassword" class="login-input" password autocomplete="new-password" :maxlength="32" placeholder="确认密码" :disabled="submitting" />
            </view>

            <!-- 学生注册图形验证码 -->
            <view v-if="registering && role == 'student'" class="student-captcha-block">
              <view class="input-wrap sms-row">
                <input v-model="studentCaptchaCode" class="login-input" :maxlength="8" :disabled="submitting" placeholder="图形验证码（必填）" @confirm="submit" />
                <image v-if="studentCaptchaImage.length > 0" class="inline-captcha-img" :src="studentCaptchaImage" mode="aspectFit" @click="loadStudentCaptcha" />
                <button v-else class="sms-btn" :disabled="loadingStudentCaptcha" @click="loadStudentCaptcha">{{ loadingStudentCaptcha ? '加载中' : '获取' }}</button>
              </view>
            </view>

            <!-- 保持登录 30 天 -->
            <view class="remember-row" @click="toggleRemember">
              <view class="remember-box" :class="{ 'remember-box-on': remember }">
                <text v-if="remember" class="remember-check">✓</text>
              </view>
              <text class="remember-text">保持登录 30 天</text>
            </view>

            <view v-if="!registering" class="form-links">
              <text v-if="role == 'parent'" class="form-link form-link-left" @click="toggleLoginMode">{{ useSms ? '密码登录' : '验证码登录' }}</text>
              <view v-else class="form-link-left"></view>
              <text class="form-link form-link-right" @click="openForgotPassword">忘记密码</text>
            </view>
            <text v-if="registering" class="agreement">注册即代表您同意《用户协议》和《隐私政策》</text>
            <text v-if="errorText.length > 0" class="login-error">{{ errorText }}</text>
            <button class="btn-primary" form-type="submit" :disabled="submitting || sendingSms">{{ submitting ? '请稍候…' : (registering ? '注册并登录' : '登录') }}</button>
            <button v-if="!registering && role == 'parent'" class="btn-register" :disabled="submitting || sendingSms" @click="enterRegistration">新家长注册</button>
            <button v-if="!registering && role == 'student'" class="btn-register" :disabled="submitting" @click="enterRegistration">注册学生账号</button>
            <button v-if="registering" class="btn-phone-login" :disabled="submitting || sendingSms" @click="openLogin(role)">← 返回登录</button>

            <view v-if="!registering && role == 'parent'" class="third-party-block">
              <view class="divider-row">
                <view class="divider-line"></view>
                <text class="divider-text">其他登录方式</text>
                <view class="divider-line"></view>
              </view>
              <button class="btn-wechat" :disabled="submitting || sendingSms" @click="goWechat">微信登录</button>
            </view>
          </form>

          <view v-if="!registering" class="page-footer">
            <text class="footer-link" @click="showLoginHelp">登录帮助</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 家长找回密码弹层 -->
    <view v-if="forgotOpen" class="overlay" @click="closeForgotPassword">
      <view class="captcha-panel" @click.stop>
        <text class="captcha-title">找回家长密码</text>
        <view class="input-wrap">
          <input v-model="forgotPhone" class="login-input" type="number" :maxlength="11" :disabled="resetting || sendingSms" placeholder="注册手机号（11位）" />
        </view>
        <view class="input-wrap sms-row">
          <input v-model="forgotSmsCode" class="login-input" type="number" :maxlength="8" :disabled="resetting" placeholder="短信验证码" />
          <button class="sms-btn" :disabled="resetting || sendingSms || waitSeconds > 0" @click="openResetCaptcha">{{ waitSeconds > 0 ? waitSeconds.toString() + 's' : '获取验证码' }}</button>
        </view>
        <view class="input-wrap">
          <input v-model="forgotNewPassword" class="login-input" password :maxlength="32" :disabled="resetting" placeholder="新密码（8-32位，含大小写+数字）" />
        </view>
        <view class="input-wrap">
          <input v-model="forgotConfirmPassword" class="login-input" password :maxlength="32" :disabled="resetting" placeholder="确认新密码" @confirm="submitForgotPassword" />
        </view>
        <text v-if="forgotError.length > 0" class="login-error">{{ forgotError }}</text>
        <button class="btn-primary" :disabled="resetting || sendingSms" @click="submitForgotPassword">{{ resetting ? '提交中…' : '重置密码' }}</button>
        <text class="form-link cancel-link" @click="closeForgotPassword">取消</text>
      </view>
    </view>

    <view v-if="showCaptcha" class="overlay" @click="closeCaptcha">
      <view class="captcha-panel" @click.stop>
        <text class="captcha-title">安全验证</text>
        <image v-if="captchaImage.length > 0" class="captcha-img" :src="captchaImage" mode="aspectFit" @click="loadCaptcha" />
        <text v-if="loadingCaptcha" class="subtitle">正在加载验证码…</text>
        <view class="input-wrap">
          <input v-model="captchaCode" class="login-input" :focus="captchaImage.length > 0" :maxlength="8" :disabled="loadingCaptcha || sendingSms" placeholder="图形验证码" @confirm="sendSms" />
        </view>
        <text v-if="captchaError.length > 0" class="login-error">{{ captchaError }}</text>
        <view class="captcha-actions">
          <button class="sms-btn" :disabled="loadingCaptcha || sendingSms" @click="loadCaptcha">换一张</button>
          <button class="btn-primary captcha-confirm" :disabled="loadingCaptcha || sendingSms || captchaId.length == 0" @click="sendSms">{{ sendingSms ? '发送中…' : '发送验证码' }}</button>
        </view>
        <text class="form-link cancel-link" @click="closeCaptcha">取消</text>
      </view>
    </view>
    <region-picker :visible="regionPickerOpen" :value="region" @confirm="onRegionConfirm" @close="regionPickerOpen = false" />
  </view>
</template>

<script setup lang="uts">
import {
  getLoginCaptcha,
  loginWithPassword,
  loginWithSms,
  registerParent,
  registerStudent,
  resetPassword,
  sendAuthSms
} from '../../api/auth.uts'
import { getRegionDisplayName } from '../../config/region/options.uts'
import { getApiErrorCode } from '../../network/request.uts'
import { familyState, getSession } from '../../state/session.uts'
import { getUserProfile } from '../../api/user.uts'
import { needsOnboarding } from './login-utils.uts'
import { meetsPasswordPolicy, PASSWORD_HINT } from '../../utils/password-policy.uts'

const role = ref('parent')
const phone = ref('')
const loginName = ref('')
const password = ref('')
const confirmPassword = ref('')
const nickname = ref('')
const realName = ref('')
const birthDate = ref('')
const grade = ref('')
const region = ref('')
const regionPickerOpen = ref(false)
const school = ref('')
const remember = ref(false)
const errorText = ref('')
const submitting = ref(false)
const useSms = ref(false)
const registering = ref(false)
const showCaptcha = ref(false)
const captchaScene = ref('login')
const forgotOpen = ref(false)
const forgotPhone = ref('')
const forgotSmsCode = ref('')
const forgotNewPassword = ref('')
const forgotConfirmPassword = ref('')
const forgotError = ref('')
const resetting = ref(false)
const captchaImage = ref('')
const captchaId = ref('')
const captchaCode = ref('')
const captchaError = ref('')
const smsCode = ref('')
const loadingCaptcha = ref(false)
const sendingSms = ref(false)
const waitSeconds = ref(0)
const studentCaptchaImage = ref('')
const studentCaptchaId = ref('')
const studentCaptchaCode = ref('')
const loadingStudentCaptcha = ref(false)
const viewportHeight = ref(0)
const topInset = ref(12)
const bottomInset = ref(12)
let resendUntil = 0
let timer = 0

const gradeOptions = ['一年级', '二年级', '三年级', '四年级', '五年级', '六年级', '初一', '初二', '初三', '高一', '高二', '高三']
const gradeIndex = computed(() => Math.max(0, gradeOptions.indexOf(grade.value)))
const regionDisplay = computed(() => getRegionDisplayName(region.value))
const now = new Date()
const todayDate = now.getFullYear().toString() + '-' + (now.getMonth() + 1).toString().padStart(2, '0') + '-' + now.getDate().toString().padStart(2, '0')
const defaultBirthDate = (now.getFullYear() - 10).toString() + '-01-01'

function toggleRemember() {
  if (!submitting.value) remember.value = !remember.value
}

function onBirthDateChange(event) {
  birthDate.value = event.detail.value.toString()
}

function onGradeChange(event) {
  grade.value = gradeOptions[parseInt(event.detail.value.toString())]
}

function openRegionPicker() {
  if (!submitting.value) regionPickerOpen.value = true
}

function onRegionConfirm(code) {
  region.value = code
  regionPickerOpen.value = false
}

/** 登录成功后按角色分流；未绑定家长的学生先进入关联码页 */
async function routeAfterAuth() {
  const session = getSession()
  if (session == null || session.role != 'student') {
    uni.reLaunch({ url: '/pages/home/index' })
    return
  }
  if (familyState.value.loaded && !familyState.value.guardianLinked) {
    uni.reLaunch({ url: '/pages/guardian/index' })
    return
  }
  try {
    const profile = await getUserProfile()
    const target = needsOnboarding(profile) ? '/pages/login/onboarding' : '/pages/home/index'
    uni.reLaunch({ url: target })
  } catch (error) {
    if (getApiErrorCode(error) == 'guardian_required') {
      uni.reLaunch({ url: '/pages/guardian/index' })
      return
    }
    uni.reLaunch({ url: '/pages/home/index' })
  }
}

function goWechat() {
  uni.navigateTo({ url: '/pages/login/wechat' })
}

function openLogin(nextRole) {
  if (submitting.value || sendingSms.value || (role.value == nextRole && !registering.value)) return
  role.value = nextRole
  registering.value = false
  useSms.value = false
  password.value = ''
  confirmPassword.value = ''
  smsCode.value = ''
  errorText.value = ''
}

function enterRegistration() {
  registering.value = true
  password.value = ''
  confirmPassword.value = ''
  smsCode.value = ''
  errorText.value = ''
  if (role.value == 'student') {
    loadStudentCaptcha()
  }
}

function toggleLoginMode() {
  if (submitting.value || sendingSms.value) return
  useSms.value = !useSms.value
  password.value = ''
  errorText.value = ''
}

async function loadStudentCaptcha() {
  if (loadingStudentCaptcha.value) return
  loadingStudentCaptcha.value = true
  errorText.value = ''
  studentCaptchaCode.value = ''
  studentCaptchaId.value = ''
  studentCaptchaImage.value = ''
  try {
    const data = await getLoginCaptcha()
    const id = data.getString('captcha_id') ?? ''
    const image = data.getString('image_base64') ?? ''
    if (id.length == 0 || image.length == 0) throw new Error('图形验证码响应无效')
    studentCaptchaId.value = id
    studentCaptchaImage.value = 'data:image/' + (data.getString('image_format') ?? 'png') + ';base64,' + image
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '无法加载图形验证码'
  } finally {
    loadingStudentCaptcha.value = false
  }
}

async function loadCaptcha() {
  if (loadingCaptcha.value || sendingSms.value) return
  loadingCaptcha.value = true
  captchaError.value = ''
  captchaCode.value = ''
  captchaId.value = ''
  captchaImage.value = ''
  try {
    const data = await getLoginCaptcha()
    const id = data.getString('captcha_id') ?? ''
    const image = data.getString('image_base64') ?? ''
    if (id.length == 0 || image.length == 0) throw new Error('图形验证码响应无效')
    captchaId.value = id
    captchaImage.value = 'data:image/' + (data.getString('image_format') ?? 'png') + ';base64,' + image
  } catch (error) {
    captchaError.value = error instanceof Error ? error.message : '无法加载图形验证码'
  } finally {
    loadingCaptcha.value = false
  }
}

function openCaptcha() {
  if (submitting.value || waitSeconds.value > 0 || sendingSms.value) return
  if (!/^\d{11}$/.test(phone.value.trim())) {
    errorText.value = '请输入正确的手机号'
    return
  }
  errorText.value = ''
  captchaScene.value = registering.value ? 'register' : 'login'
  showCaptcha.value = true
  loadCaptcha()
}

function openForgotPassword() {
  if (submitting.value || sendingSms.value) return
  if (role.value == 'student') {
    uni.showModal({
      title: '忘记密码',
      content: '学生账号不支持自主找回密码，请联系已关联家长在「孩子账户管理 → 重置密码」中协助重置。',
      showCancel: false
    })
    return
  }
  forgotPhone.value = phone.value.trim()
  forgotSmsCode.value = ''
  forgotNewPassword.value = ''
  forgotConfirmPassword.value = ''
  forgotError.value = ''
  forgotOpen.value = true
}

function closeForgotPassword() {
  if (!resetting.value) forgotOpen.value = false
}

function openResetCaptcha() {
  if (resetting.value || waitSeconds.value > 0 || sendingSms.value) return
  if (!/^\d{11}$/.test(forgotPhone.value.trim())) {
    forgotError.value = '请输入正确的手机号'
    return
  }
  forgotError.value = ''
  captchaScene.value = 'reset'
  showCaptcha.value = true
  loadCaptcha()
}

async function submitForgotPassword() {
  if (resetting.value || sendingSms.value) return
  forgotError.value = ''
  const targetPhone = forgotPhone.value.trim()
  const code = forgotSmsCode.value.trim()
  const nextPwd = forgotNewPassword.value.trim()
  if (!/^\d{11}$/.test(targetPhone)) {
    forgotError.value = '请输入正确的手机号'
    return
  }
  if (!/^\d{4,8}$/.test(code)) {
    forgotError.value = '请输入短信验证码'
    return
  }
  if (!meetsPasswordPolicy(nextPwd)) {
    forgotError.value = PASSWORD_HINT
    return
  }
  if (nextPwd != forgotConfirmPassword.value.trim()) {
    forgotError.value = '两次输入的新密码不一致'
    return
  }
  resetting.value = true
  try {
    await resetPassword(targetPhone, code, nextPwd)
    forgotOpen.value = false
    phone.value = targetPhone
    useSms.value = false
    password.value = ''
    uni.showToast({ title: '密码已重置，请用新密码登录', icon: 'none' })
  } catch (error) {
    forgotError.value = error instanceof Error ? error.message : '重置失败，请重试'
  } finally {
    resetting.value = false
  }
}

function closeCaptcha() {
  if (!sendingSms.value) showCaptcha.value = false
}

function updateCountdown() {
  waitSeconds.value = Math.max(0, Math.ceil((resendUntil - Date.now()) / 1000))
  if (waitSeconds.value == 0 && timer != 0) {
    clearInterval(timer)
    timer = 0
  }
}

async function sendSms() {
  if (loadingCaptcha.value || sendingSms.value || captchaId.value.length == 0) return
  const code = captchaCode.value.trim()
  if (code.length < 4) {
    captchaError.value = '请先填写图形验证码'
    return
  }
  sendingSms.value = true
  captchaError.value = ''
  try {
    const targetPhone = captchaScene.value == 'reset' ? forgotPhone.value.trim() : phone.value.trim()
    const data = await sendAuthSms(targetPhone, captchaScene.value, captchaId.value, code)
    resendUntil = Date.now() + Math.max(1, data.getNumber('resend_after') ?? 60) * 1000
    updateCountdown()
    timer = setInterval(updateCountdown, 1000)
    showCaptcha.value = false
    uni.showToast({ title: data.getString('message') ?? '若号码有效，验证码已发送', icon: 'none' })
  } catch (error) {
    const message = error instanceof Error ? error.message : '发送失败，请重试'
    sendingSms.value = false
    await loadCaptcha()
    captchaError.value = message
  } finally {
    sendingSms.value = false
  }
}

async function submit() {
  if (submitting.value || sendingSms.value) return
  errorText.value = ''
  const account = role.value == 'parent' ? phone.value.trim() : loginName.value.trim()
  const secret = password.value.trim()
  const needsParentSms = role.value == 'parent' && (useSms.value || registering.value)

  if (role.value == 'parent' && !/^\d{11}$/.test(account)) {
    errorText.value = '请输入正确的手机号'
    return
  }
  if (role.value == 'student' && account.length < 2) {
    errorText.value = '孩子账号至少 2 位'
    return
  }
  if (needsParentSms && !/^\d{4,8}$/.test(smsCode.value)) {
    errorText.value = '请输入短信验证码'
    return
  }
  if (!needsParentSms && !registering.value && secret.length < 6) {
    errorText.value = '密码至少 6 位'
    return
  }
  if (registering.value) {
    if (role.value == 'parent') {
      if (!/^[\u4e00-\u9fa5·]{2,20}$/.test(realName.value.trim())) {
        errorText.value = '请填写 2 至 20 个字符的中文姓名（可含·）'
        return
      }
      if (nickname.value.trim().length < 2) {
        errorText.value = '昵称至少 2 个字符'
        return
      }
    } else {
      if (realName.value.trim().length < 2) {
        errorText.value = '请填写学生姓名（至少 2 个字符）'
        return
      }
      if (birthDate.value.length == 0) {
        errorText.value = '请选择出生日期'
        return
      }
      if (studentCaptchaId.value.length == 0 || studentCaptchaCode.value.trim().length < 4) {
        errorText.value = '请填写图形验证码'
        return
      }
    }
    if (!meetsPasswordPolicy(secret)) {
      errorText.value = PASSWORD_HINT
      return
    }
    if (secret != confirmPassword.value.trim()) {
      errorText.value = '两次输入的密码不一致'
      return
    }
  }

  submitting.value = true
  try {
    if (registering.value && role.value == 'student') {
      await registerStudent({
        loginName: account,
        password: secret,
        realName: realName.value.trim(),
        nickname: nickname.value.trim(),
        birthDate: birthDate.value,
        grade: grade.value,
        school: school.value.trim(),
        region: region.value,
        captchaId: studentCaptchaId.value,
        captchaCode: studentCaptchaCode.value.trim(),
        remember: remember.value
      })
    } else if (registering.value) {
      await registerParent(account, smsCode.value, realName.value.trim(), nickname.value.trim(), secret, remember.value)
    } else if (role.value == 'parent' && useSms.value) {
      await loginWithSms(account, smsCode.value, remember.value)
    } else {
      await loginWithPassword(role.value, account, secret, remember.value)
    }
    password.value = ''
    confirmPassword.value = ''
    routeAfterAuth()
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '登录失败，请重试'
    if (registering.value && role.value == 'student') {
      loadStudentCaptcha()
    }
  } finally {
    submitting.value = false
  }
}

function showLoginHelp() {
  uni.showActionSheet({
    itemList: ['家长登录说明', '孩子登录说明'],
    success: (result) => {
      const parent = result.tapIndex == 0
      uni.showModal({
        title: parent ? '家长怎么登录' : '孩子怎么登录',
        content: parent
          ? '使用注册时的手机号和密码或短信验证码登录。新用户可以选择「新家长注册」。'
          : '使用家长分配或自助注册的学生账号密码登录。未关联家长时，登录后生成 8 位关联码交由家长绑定即可使用完整功能。',
        showCancel: false
      })
    }
  })
}

onLoad(() => {
  if (getSession() != null) routeAfterAuth()
})

onReady(() => {
  const info = uni.getWindowInfo()
  viewportHeight.value = info.windowHeight
  topInset.value = Math.max(12, info.safeAreaInsets.top)
  bottomInset.value = Math.max(12, info.safeAreaInsets.bottom)
})

onUnload(() => {
  if (timer != 0) clearInterval(timer)
})
</script>

<style lang="scss" scoped>
@import './index.scss';
</style>
