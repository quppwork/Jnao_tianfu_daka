<template>
  <view class="bl-page">
    <view class="bl-header" :style="{ paddingTop: insetTop + 'px' }">
      <view class="bl-back" @click="goBack"><text class="bl-back-icon">‹</text></view>
      <text class="bl-title">黑名单</text>
      <view class="bl-placeholder"></view>
    </view>

    <!-- 分类切页 -->
    <view class="bl-tabs">
      <view
        v-for="(t, i) in TABS"
        :key="i"
        class="bl-tab"
        :class="tabIndex == i ? 'bl-tab-on' : ''"
        @click="switchTab(i)"
      >
        <text class="bl-tab-text">{{ t.label }} {{ countOf(t.kind) }}</text>
      </view>
    </view>

    <scroll-view class="bl-body" scroll-y>
      <view v-if="loading" class="bl-empty"><text class="bl-empty-text">加载中…</text></view>

      <template v-else>
        <view v-if="currentRows.length == 0" class="bl-empty">
          <text class="bl-empty-text">这类里没有记录</text>
        </view>

        <view v-for="(r, i) in currentRows" :key="i" class="bl-row">
          <view class="bl-row-main">
            <text class="bl-row-value">{{ r.value }}</text>
            <text class="bl-row-kind">{{ r.kind }}</text>
          </view>
          <view class="bl-row-del" @click="askRemove(r)">
            <text class="bl-row-del-text">移除</text>
          </view>
        </view>
      </template>

      <text v-if="errorText.length > 0" class="bl-error">{{ errorText }}</text>
      <view class="bl-space"></view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { listAdminBlacklist, removeAdminBlacklist, readAdminBlacklist } from '../../api/admin.uts'
import { getPageTopInset } from '../../utils/layout.uts'

const TABS = [
  { kind: 'ip', label: 'IP' },
  { kind: 'phone', label: '手机号' },
  { kind: 'device', label: '设备' }
]

const loading = ref(true)
const errorText = ref('')
const insetTop = ref(0)
const tabIndex = ref(0)
const rows = ref([])

function goBack() {
  uni.navigateBack()
}

function currentKind() {
  return TABS[tabIndex.value].kind
}

const currentRows = computed(() => {
  const k = currentKind()
  const list = []
  for (let i = 0; i < rows.value.length; i++) {
    if (rows.value[i].kind == k) list.push(rows.value[i])
  }
  return list
})

function countOf(kind) {
  let n = 0
  for (let i = 0; i < rows.value.length; i++) {
    if (rows.value[i].kind == kind) n = n + 1
  }
  return n
}

function switchTab(index) {
  tabIndex.value = index
}

async function load() {
  loading.value = true
  errorText.value = ''
  try {
    const data = await listAdminBlacklist()
    rows.value = readAdminBlacklist(data)
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '加载黑名单失败'
  } finally {
    loading.value = false
  }
}

function askRemove(row) {
  uni.showModal({
    title: '移除这条记录？',
    content: row.value,
    success: (res) => {
      if (res.confirm) {
        removeOne(row)
      }
    }
  })
}

async function removeOne(row) {
  try {
    await removeAdminBlacklist(row.kind, row.value)
    uni.showToast({ title: '已移除', icon: 'none' })
    await load()
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '移除失败'
  }
}

onLoad(() => {
  load()
})

onReady(() => {
  insetTop.value = getPageTopInset()
})
</script>

<style lang="scss" scoped>
@import './blacklist.scss';
</style>
