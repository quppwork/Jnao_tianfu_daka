<template>
  <view class="report">
    <view class="top" :style="{ marginTop: inset + 'px' }">
      <view class="back" @click="goBack"><text class="back-icon">‹</text></view>
      <text class="title top-title">{{ topTitle }}</text>
      <view class="spacer"></view>
    </view>
    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <text v-if="loading" class="dim">正在读取完整天赋报告…</text>
        <view v-if="errorText.length > 0" class="card">
          <text class="error">{{ errorText }}</text>
          <button class="secondary" @click="loadReport">重试</button>
        </view>

        <view v-if="notice.length > 0" class="card"><text class="dim">{{ notice }}</text></view>

        <view v-if="pending.length > 0" class="card">
          <text class="title">确认训练使用的天赋</text>
          <text class="dim">当前天赋 {{ current }} · 新测评 {{ pending }}</text>
          <text v-if="lastChance" class="dim">这是最后一次可采用新天赋的机会。</text>
          <button class="primary" :disabled="saving" @click="chooseTalent('use_new')">采用新测评结果</button>
          <button class="secondary" :disabled="saving" @click="chooseTalent('keep_old')">保留当前天赋</button>
        </view>

        <AdultReportView
          v-if="fullReport != null && fullReport.testType == 1"
          :report="fullReport"
          :nickname="nickname"
        />
        <KidReportView
          v-if="fullReport != null && fullReport.testType == 2"
          :report="fullReport"
          :nickname="nickname"
        />

        <button v-if="fullReport != null && pending.length == 0" class="primary" @click="goChat">问大宇 · 就报告内容提问</button>
        <button v-if="fullReport != null && pending.length == 0" class="secondary" @click="goRelation">发起关系合测</button>
        <button v-if="fullReport != null && pending.length == 0" class="secondary" @click="goBack">返回</button>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import AdultReportView from '../../components/report/AdultReportView.uvue'
import KidReportView from '../../components/report/KidReportView.uvue'
import { requestJson } from '../../network/request.uts'
import { getFullTalentReport } from '../../api/talent.uts'
import { parseFullTalentReport } from '../../api/talent-parsers.uts'
import { FullTalentReport } from '../../api/talent-types.uts'
import { getSession } from '../../state/session.uts'
import { getPageTopInset } from '../../utils/layout.uts'

const id = ref(0)
const inset = ref(0)
const loading = ref(false)
const saving = ref(false)
const fullReport = ref<FullTalentReport | null>(null)
const nickname = ref('')
const notice = ref('')
const pending = ref('')
const current = ref('')
const lastChance = ref(false)
const errorText = ref('')

const topTitle = computed((): string => {
  const r = fullReport.value
  if (r == null) return '天赋报告'
  return r.testType == 1 ? '成人天赋报告' : '孩子天赋报告'
})

async function loadReport() {
  if (loading.value || id.value <= 0) return
  loading.value = true
  errorText.value = ''
  try {
    const resp = await getFullTalentReport(id.value)
    const parsed = parseFullTalentReport(resp)
    if (parsed.isMihai == 1) {
      uni.redirectTo({
        url: '/pages/talent/supplement?assessment_id=' + id.value.toString() + '&test_type=' + parsed.testType.toString()
      })
      return
    }
    fullReport.value = parsed

    const session = getSession()
    nickname.value = session?.nickname ?? ''
    if (session?.role == 'student') {
      const profile = await requestJson('/api/user/profile')
      const profileData = profile.getJSON('profile_json')
      const change = profile.getJSON('pending_talent') ?? profileData?.getJSON('pending_talent')
      if (change?.getNumber('assessment_id') == id.value) {
        pending.value = change?.getString('talent_primary') ?? ''
        current.value = profile.getString('talent_primary') ?? profileData?.getString('talent_primary') ?? ''
        lastChance.value = change?.getBoolean('from_last_chance') == true
      }
    }
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '读取天赋报告失败'
  } finally {
    loading.value = false
  }
}

async function resolveTalent(action: string) {
  if (saving.value) return
  saving.value = true
  errorText.value = ''
  try {
    await requestJson('/api/user/talent/resolve-conflict', 'POST', { action: action })
    pending.value = ''
    notice.value = action == 'use_new' ? '已采用新测评结果，训练将按新天赋安排。' : '已保留当前训练天赋。'
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '保存天赋选择失败'
  } finally {
    saving.value = false
  }
}

function chooseTalent(action: string) {
  if (saving.value) return
  uni.showModal({
    title: action == 'use_new' ? '采用新天赋' : '保留当前天赋',
    content: action == 'use_new' ? '采用新天赋后，系统将按新天赋安排后续训练。确定采用吗？' : '确定继续使用当前训练天赋吗？',
    success: (result) => { if (result.confirm) resolveTalent(action) }
  })
}

function goChat() {
  const aid = id.value
  if (aid <= 0) {
    uni.showToast({ title: '报告还没准备好', icon: 'none' })
    return
  }
  uni.navigateTo({ url: '/pages/talent/chat?id=' + aid.toString() })
}

function goRelation() {
  uni.navigateTo({ url: '/pages/talent/relation' })
}

function goBack() {
  uni.navigateBack()
}

onLoad((options) => {
  const reportId = parseInt(options['assessment_id'] ?? options['id'] ?? '')
  if (!isNaN(reportId) && reportId > 0) id.value = reportId
  const note = options['notice'] ?? ''
  if (note.length > 0) notice.value = decodeURIComponent(note)
  if (id.value > 0) loadReport()
  else errorText.value = '缺少测评报告编号'
})

onReady(() => {
  inset.value = getPageTopInset()
})
</script>

<style lang="scss" scoped>
@import './index.scss';
</style>
