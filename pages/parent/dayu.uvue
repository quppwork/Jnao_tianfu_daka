<template>
  <view class="pd-page">
    <!-- 原版家长顶栏 -->
    <view class="pd-header" :style="{ paddingTop: insetTop + 'px' }">
      <view class="pd-brand">
        <text class="pd-brand-t1">大宇智能体</text>
        <text class="pd-brand-t2">PARENT · 家长版</text>
      </view>
      <view class="pd-actions">
        <view class="pd-chip-gold" @click="openChildren">
          <text class="pd-chip-gold-text">孩子管理</text>
        </view>
        <view class="pd-chip-ghost" @click="signOut">
          <text class="pd-chip-ghost-text">{{ signingOut ? '退出中' : '退出' }}</text>
        </view>
      </view>
    </view>

    <!-- 原版导师团头图（使用本地图片，本地/线上永不图裂） -->
    <view class="pd-hero">
      <image class="pd-hero-img" src="/static/parent/parent-team.jpg" mode="aspectFill" />
      <text class="pd-teamtag">天赋导师团</text>
      <view class="pd-cap">
        <text class="pd-cap-t">张宇老师 · 天赋导师团</text>
        <text class="pd-cap-s">不是一个人，是一支教育团队——陪孩子，也陪家长</text>
      </view>
    </view>

    <!-- 原版家长三入口卡 -->
    <view class="pd-tri">
      <view class="pd-tri-item" @click="openTalentTest">
        <image class="pd-tri-ic" src="/static/dayu/ic/dna.png" mode="aspectFit" />
        <text class="pd-tri-n">天赋测试</text>
        <text class="pd-tri-s">孩子·自己都能测</text>
      </view>
      <view class="pd-tri-item" @click="openParentCourse">
        <image class="pd-tri-ic" src="/static/dayu/ic/cap.png" mode="aspectFit" />
        <text class="pd-tri-n">家长课堂</text>
        <text class="pd-tri-s">6门课·72讲</text>
      </view>
      <view class="pd-tri-item pd-tri-last" @click="openConsult">
        <image class="pd-tri-ic" src="/static/dayu/ic/bubble.png" mode="aspectFit" />
        <text class="pd-tri-n">一键咨询</text>
        <text class="pd-tri-s pd-tri-live">● 真人导师在线</text>
      </view>
    </view>

    <!-- 家长大宇对话区 -->
    <scroll-view class="pd-body" scroll-y :scroll-into-view="scrollAnchor" :show-scrollbar="false">
      <view class="pd-messages">
        <view v-if="messages.length == 0" class="pd-intro">
          <image class="pd-intro-av" src="/static/dayu/avatar_sizhe.jpg" mode="aspectFill" />
          <view class="pd-intro-bubble">
            <text class="pd-intro-text">
              您好！我是大宇智能体家长版。孩子的天赋训练进度、家长课堂选课、测评报告解读，随时问我。
            </text>
          </view>
        </view>

        <view v-if="messages.length == 0 && suggests.length > 0" class="pd-suggests">
          <view
            v-for="(s, i) in suggests"
            :key="i.toString()"
            class="pd-suggest"
            @click="sendSuggest(s)"
          >
            <text class="pd-suggest-text">{{ s }}</text>
          </view>
        </view>

        <chat-bubble
          v-for="(m, index) in messages"
          :key="index.toString()"
          :role="m.role"
          :content="m.content"
          :pending="m.pending"
          accent="gold"
        />
        <view id="pd-bottom" class="pd-anchor"></view>
      </view>
    </scroll-view>

    <view v-if="statusText.length > 0" class="pd-status">
      <text class="pd-status-text">{{ statusText }}</text>
    </view>
    <view v-if="errorText.length > 0" class="pd-error">
      <text class="pd-error-text">{{ errorText }}</text>
    </view>

    <chat-composer
      :sending="sending"
      :inset="0"
      accent="gold"
      placeholder="问大宇：孩子训练 / 家长课程 / 报告解读…"
      @submit="onSubmit"
      @stop="stop"
    />

    <dayu-tab-bar role="parent" active="dayu" />
  </view>
</template>

<script setup lang="uts">
import { logout } from '../../api/auth.uts'
import {
  getParentGuideSession,
  getParentSuggestPrompts,
  listChildren,
  readFirstChildId,
  readParentMessages,
  readParentSuggests,
  parentGuideChatStream,
} from '../../api/parent.uts'
import { getSession, returnToLogin } from '../../state/session.uts'
import { getPageTopInset } from '../../utils/layout.uts'
import {
  finishTurn,
  reduceSse,
  startUserTurn,
  toMessages
} from '../../utils/chatMessages.uts'

const suggests = ref([
  '学者天赋是什么',
  '什么是火箭提分营',
  '火箭提分营适合什么样的孩子'
])

const messages = ref([])
const sending = ref(false)
const signingOut = ref(false)
const statusText = ref('')
const errorText = ref('')
const sessionId = ref(0)
const focusChildId = ref(0)
const scrollAnchor = ref('')
const insetTop = ref(0)

let requestTask: RequestTask | null = null
let requestSeq = 0
let scrollTimer = 0

function clearScrollTimer() {
  if (scrollTimer != 0) {
    clearTimeout(scrollTimer)
    scrollTimer = 0
  }
}

function abortActiveStream() {
  requestSeq = requestSeq + 1
  const task = requestTask
  requestTask = null
  if (task != null) task.abort()
}

function snapshot() {
  return {
    messages: messages.value,
    sending: sending.value,
    statusText: statusText.value,
    errorText: errorText.value,
    sessionId: sessionId.value
  }
}

function applyState(state) {
  messages.value = state.messages
  sending.value = state.sending
  statusText.value = state.statusText
  errorText.value = state.errorText
  sessionId.value = state.sessionId
}

function openChildren() {
  uni.navigateTo({ url: '/pages/parent/index' })
}

function openTalentTest() {
  uni.navigateTo({ url: '/pages/talent/index' })
}

function openParentCourse() {
  uni.navigateTo({ url: '/pages/parent/pcourse' })
}

function openConsult() {
  uni.redirectTo({ url: '/pages/parent/consult' })
}

async function signOut() {
  if (signingOut.value) return
  signingOut.value = true
  try {
    await logout()
    returnToLogin()
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '退出失败，请重试'
  } finally {
    signingOut.value = false
  }
}

function scrollToBottom() {
  clearScrollTimer()
  scrollAnchor.value = ''
  scrollTimer = setTimeout(() => {
    scrollTimer = 0
    scrollAnchor.value = 'pd-bottom'
  }, 16)
}

function onSseEvent(seq, event) {
  if (seq != requestSeq) return
  applyState(reduceSse(snapshot(), event))
  if (event.type == 'done' || event.type == 'error' || event.type == 'abort') {
    requestTask = null
  }
  if (event.type == 'token' || event.type == 'replace' || event.type == 'done') {
    scrollToBottom()
  }
}

function onSubmit(text) {
  if (sending.value) return
  applyState(startUserTurn(snapshot(), text))
  scrollToBottom()

  requestSeq = requestSeq + 1
  const seq = requestSeq
  const options = {
    message: text,
    sessionId: sessionId.value,
    childId: focusChildId.value
  }
  const task = parentGuideChatStream(options, (event) => {
    onSseEvent(seq, event)
  })
  if (task == null) {
    applyState(finishTurn(snapshot()))
    return
  }
  requestTask = task
}

function sendSuggest(text) {
  onSubmit(text)
}

function stop() {
  abortActiveStream()
  applyState(finishTurn(snapshot()))
}

async function loadFocusChild() {
  try {
    const id = readFirstChildId(await listChildren())
    if (id > 0) focusChildId.value = id
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '读取孩子列表失败'
  }
}

async function loadHistory() {
  try {
    const data = await getParentGuideSession()
    const sid = data.getNumber('session_id')
    if (sid != null && sid > 0) sessionId.value = sid
    const list = toMessages(readParentMessages(data))
    if (list.length > 0) {
      messages.value = list
      scrollToBottom()
    }
  } catch (_) {
    // 首次进入没有历史会话属于正常情况
  }
}

async function loadSuggests() {
  try {
    const data = await getParentSuggestPrompts(3)
    const list = readParentSuggests(data)
    if (list.length > 0) suggests.value = list
  } catch (_) {
    // 取不到就用默认建议
  }
}

onLoad(() => {
  const session = getSession()
  if (session == null) {
    returnToLogin()
    return
  }
  loadFocusChild()
  loadHistory()
  loadSuggests()
})

onReady(() => {
  insetTop.value = getPageTopInset()
})

onUnload(() => {
  abortActiveStream()
  clearScrollTimer()
})
</script>

<style lang="scss" scoped>
@import './dayu.scss';
</style>
