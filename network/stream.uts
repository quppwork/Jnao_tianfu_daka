import { getApiOrigin } from '../config/environment.uts'
import { clearSession, getSession, returnToLogin } from '../state/session.uts'

/**
 * 后端 SSE 事件类型（见 backend/app/core/sse.py）
 * token   增量文本      status  过程中提示     replace 整段替换
 * meta    附加元数据    done    结束           error   错误
 * abort   本地主动中断（非后端事件）
 */
export type SseEvent = {
  type: string
  content: string
  message: string
  payload: UTSJSONObject | null
}

export type SseEventSink = (event: SseEvent) => void

/** 流式请求超时：AI 长回答需要远高于普通请求的预算 */
const STREAM_TIMEOUT_MS = 600000

const LF = 10
const CR = 13

function makeEvent(type: string, content: string, message: string, payload: UTSJSONObject | null): SseEvent {
  return { type, content, message, payload }
}

function concatBytes(a: Uint8Array, b: Uint8Array): Uint8Array {
  const out = new Uint8Array(a.length + b.length)
  out.set(a, 0)
  out.set(b, a.length)
  return out
}

/**
 * 纯 UTS UTF-8 解码，避免依赖全局 TextDecoder（部分微信小程序真机基础库缺失 TextDecoder）。
 * 调用方保证按 SSE 空行边界切分，多字节 UTF-8 字符不会被跨块截断。
 */
function decodeUtf8(bytes: Uint8Array): string {
  const parts: string[] = []
  let i = 0
  const len = bytes.length
  while (i < len) {
    const b0 = bytes[i]
    if (b0 < 0x80) {
      parts.push(String.fromCharCode(b0))
      i += 1
    } else if ((b0 & 0xe0) == 0xc0 && i + 1 < len) {
      const cp = ((b0 & 0x1f) << 6) | (bytes[i + 1] & 0x3f)
      parts.push(String.fromCharCode(cp))
      i += 2
    } else if ((b0 & 0xf0) == 0xe0 && i + 2 < len) {
      const cp = ((b0 & 0x0f) << 12) | ((bytes[i + 1] & 0x3f) << 6) | (bytes[i + 2] & 0x3f)
      parts.push(String.fromCharCode(cp))
      i += 3
    } else if ((b0 & 0xf8) == 0xf0 && i + 3 < len) {
      const cp =
        ((b0 & 0x07) << 18) |
        ((bytes[i + 1] & 0x3f) << 12) |
        ((bytes[i + 2] & 0x3f) << 6) |
        (bytes[i + 3] & 0x3f)
      const offset = cp - 0x10000
      parts.push(String.fromCharCode(0xd800 + (offset >> 10), 0xdc00 + (offset & 0x3ff)))
      i += 4
    } else {
      parts.push('\uFFFD')
      i += 1
    }
  }
  return parts.join('')
}

/** 解析一个已解码的 SSE 事件块（不含结尾空行），返回是否触发了终结事件（done/error） */
function dispatchBlock(block: string, sink: SseEventSink): boolean {
  const lines = block.split('\n')
  let raw = ''
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].endsWith('\r') ? lines[i].substring(0, lines[i].length - 1) : lines[i]
    if (line.startsWith('data:')) {
      raw = line.substring(5).trim()
      break
    }
  }
  if (raw.length == 0) return false
  if (raw == '[DONE]') return false

  let obj: UTSJSONObject | null = null
  try {
    obj = JSON.parse<UTSJSONObject>(raw)
  } catch (_) {
    obj = null
  }
  if (obj == null) {
    sink(makeEvent('token', raw, '', null))
    return false
  }

  const type = obj.getString('type') ?? 'token'
  if (type == 'token') {
    const content = obj.getString('content') ?? ''
    if (content.length > 0) sink(makeEvent('token', content, '', null))
    return false
  } else if (type == 'status') {
    const message = obj.getString('message') ?? obj.getString('content') ?? ''
    if (message.length > 0) sink(makeEvent('status', '', message, null))
    return false
  } else if (type == 'replace') {
    sink(makeEvent('replace', obj.getString('content') ?? '', '', null))
    return false
  } else if (type == 'done') {
    sink(makeEvent('done', '', '', obj))
    return true
  } else if (type == 'error') {
    sink(makeEvent('error', '', obj.getString('message') ?? 'AI 服务暂时异常，请稍后再试', null))
    return true
  } else if (type == 'meta') {
    sink(makeEvent('meta', '', '', obj))
    return false
  }
  return false
}

/**
 * POST + SSE 流式读取。
 *
 * 返回 RequestTask，调用方持有它以便 abort()；未登录时返回 null 并跳转登录。
 *
 * 分块策略：不逐块解码。UTF-8 的续字节范围是 0x80-0xBF，永远不会等于换行 0x0A/0x0D，
 * 所以在字节层定位 `\n\n` 或 `\r\n\r\n` 事件边界再解码，中文绝不会被切坏。
 */
export function streamPost(path: string, body: UTSJSONObject, sink: SseEventSink): RequestTask | null {
  const session = getSession()
  if (session == null) {
    returnToLogin()
    return null
  }
  const origin = getApiOrigin()
  const headers: UTSJSONObject = {
    'Content-Type': 'application/json',
    'Accept': 'text/event-stream',
    'X-Child-User-Id': session.userId.toString()
  }
  if (session.accessToken.length > 0) {
    headers['Authorization'] = 'Bearer ' + session.accessToken
    headers['X-Session-Token'] = session.accessToken
  }

  let pending: Uint8Array | null = null
  let receivedChunk = false
  let doneReceived = false
  let settled = false

  function emitFromBytes(bytes: Uint8Array) {
    let start = 0
    let i = 0
    while (i + 1 < bytes.length) {
      let sepLen = 0
      if (bytes[i] == LF && bytes[i + 1] == LF) {
        sepLen = 2
      } else if (
        i + 3 < bytes.length &&
        bytes[i] == CR &&
        bytes[i + 1] == LF &&
        bytes[i + 2] == CR &&
        bytes[i + 3] == LF
      ) {
        sepLen = 4
      }
      if (sepLen > 0) {
        const seg = bytes.slice(start, i)
        if (seg.length > 0 && dispatchBlock(decodeUtf8(seg), sink)) {
          doneReceived = true
        }
        i += sepLen
        start = i
        continue
      }
      i += 1
    }
    pending = start < bytes.length ? bytes.slice(start) : null
  }

  const task = uni.request({
    url: origin + path,
    method: 'POST',
    header: headers,
    data: body,
    enableChunked: true,
    withCredentials: true,
    timeout: STREAM_TIMEOUT_MS,
    // #ifndef APP-ANDROID && UNI-APP-X && !VUE3-VAPOR
    dataType: 'text',
    // #endif
    success: (response) => {
      if (settled) return
      settled = true
      const status = response.statusCode
      if (status == 401) {
        // 只有会话仍是本次请求用的那个才清，避免并发请求误清新登录态
        const current = getSession()
        if (current != null && current.accessToken == session.accessToken) {
          clearSession()
          returnToLogin()
        }
        sink(makeEvent('error', '', '登录已过期，请重新登录', null))
        return
      }
      if (status < 200 || status >= 300) {
        sink(makeEvent('error', '', 'AI 服务返回 ' + status.toString(), null))
        return
      }
      // 冲刷尾部：流结尾可能没有空行
      if (pending != null && pending.length > 0) {
        const tail = decodeUtf8(pending)
        pending = null
        if (tail.trim().length > 0 && dispatchBlock(tail, sink)) {
          doneReceived = true
        }
      }
      if (!receivedChunk) {
        // 该端没有走 onChunkReceived：明确报错，不让 UI 停在 loading
        sink(makeEvent('error', '', '当前平台不支持流式输出，请升级基础库或改用小程序端', null))
      } else if (!doneReceived) {
        // 后端正常结束流但未发显式 done 事件时兜底收尾，避免输入框永久锁死
        sink(makeEvent('done', '', '', null))
      }
    },
    fail: (err) => {
      if (settled) return
      settled = true
      const raw = err.errMsg
      const lower = raw.toLowerCase()
      if (lower.indexOf('abort') >= 0) {
        sink(makeEvent('abort', '', '已停止生成', null))
        return
      }
      sink(makeEvent('error', '', raw.length > 0 ? '连接中断：' + raw : '连接中断，请检查网络', null))
    }
  })

  task.onChunkReceived((response: RequestTaskOnChunkReceivedListenerResult) => {
    if (settled) return
    receivedChunk = true
    const incoming = new Uint8Array(response.data)
    if (incoming.length == 0) return
    emitFromBytes(pending == null ? incoming : concatBytes(pending, incoming))
  })

  return task
}
