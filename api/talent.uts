import { requestJson } from '../network/request.uts'
import { streamPost, SseEventSink } from '../network/stream.uts'
import { LLM_TIMEOUT_MS } from '../network/timeouts.uts'
import {
  KidDraftInput,
  KidDraftResult,
  TalentSubmitInput
} from './talent-types.uts'

/** 天赋测评、迷者补充、完整报告、关系测评与报告内解答 */

/** 1. 拉取 35 题题库：questionType 1=成人 / 2=儿童(6-9岁) / 3=少年(10-16岁) */
export function fetchTalentQuestions(questionType: number): Promise<UTSJSONObject> {
  return requestJson('/api/talent/questions?question_type=' + questionType.toString())
}

/** 2. 创建儿童测评预记录，返回 draft_id + question_type(2或3) */
export async function createKidDraft(input: KidDraftInput): Promise<KidDraftResult> {
  const body: UTSJSONObject = {
    sex: input.sex,
    age: input.age,
    rela: input.rela,
    resultas: input.resultas
  }
  if (input.targetChildId > 0) body['target_child_id'] = input.targetChildId
  const resp = await requestJson('/api/talent/kid/draft', 'POST', body)
  const data = resp.getJSON('data') ?? resp
  const draftId = data.getNumber('draft_id') ?? data.getNumber('id') ?? 0
  const questionType = data.getNumber('question_type') ?? (input.age >= 10 ? 3 : 2)
  if (draftId <= 0) {
    throw new Error(resp.getString('msg') ?? '创建儿童测评预记录失败')
  }
  return { draftId: draftId, questionType: questionType }
}

/** 3. 提交 35 题答案并直连 WuDao 算分（testType: 1=成人 / 2=儿童） */
export function submitTalentAssessment(input: TalentSubmitInput): Promise<UTSJSONObject> {
  const body: UTSJSONObject = {
    test_type: input.testType,
    answer: input.answer
  }
  if (input.sex > 0) body['sex'] = input.sex
  if (input.age > 0) body['age'] = input.age
  if (input.draftId > 0) body['draft_id'] = input.draftId
  return requestJson('/api/talent/submit', 'POST', body, null, true, LLM_TIMEOUT_MS)
}

/** 4. 拉取迷者（发哥）3 轮补充测试题库：type 0=儿童/家长视角, 1=成人/学生视角 */
export function fetchSupplementQuestions(type: number): Promise<UTSJSONObject> {
  return requestJson('/api/talent/supplement/questions?type=' + type.toString())
}

/** 5. 提交迷者补充测试结果（两字组合如 赢思） */
export function submitSupplementTalent(assessmentId: number, talent: string): Promise<UTSJSONObject> {
  const body: UTSJSONObject = {
    assessment_id: assessmentId,
    talent: talent
  }
  return requestJson('/api/talent/supplement/submit', 'POST', body)
}

/** 6. 获取完整报告页数据（成人富化 / 儿童完整 + talent_config） */
export function getFullTalentReport(assessmentId: number): Promise<UTSJSONObject> {
  return requestJson('/api/talent/report/' + assessmentId.toString())
}

/** 7. 获取静态天赋配置（0=全部, 1=成人, 2=儿童） */
export function getTalentConfig(testType: number = 0): Promise<UTSJSONObject> {
  return requestJson('/api/talent/config?test_type=' + testType.toString())
}

/** 8. 关系测评：提交合测（好友或自己的孩子） */
export function submitRelationAssessment(
  rela: number,
  friendUserId: number,
  targetChildId: number
): Promise<UTSJSONObject> {
  const body: UTSJSONObject = {
    rela: rela,
    friend_user_id: friendUserId,
    target_child_id: targetChildId
  }
  return requestJson('/api/talent/relation/submit', 'POST', body, null, true, LLM_TIMEOUT_MS)
}

/** 9. 关系测评：检查孩子合测前置条件 */
export function getRelationChildInfo(childId: number): Promise<UTSJSONObject> {
  return requestJson('/api/talent/relation/child-info?child_id=' + childId.toString())
}

/** 10. 关系测评：受邀方落地页信息 */
export function getRelationGuestInfo(friendUserId: number, rela: number): Promise<UTSJSONObject> {
  return requestJson(
    '/api/talent/relation/guest-info?friend_user_id=' + friendUserId.toString() + '&rela=' + rela.toString()
  )
}

/** 11. 关系测评：历史列表 */
export function listRelationAssessments(): Promise<UTSJSONObject> {
  return requestJson('/api/talent/relation/list')
}

/** 12. 关系测评：报告详情 */
export function getRelationReport(relationId: number): Promise<UTSJSONObject> {
  return requestJson('/api/talent/relation/' + relationId.toString())
}

/** type: 0 成人 / 1 儿童（兼容旧调用方） */
export function submitTalentReport(
  answer: string,
  uid: number,
  type: number,
  childUserId: number
): Promise<UTSJSONObject> {
  const body: UTSJSONObject = { answer: answer, uid: uid, type: type }
  if (childUserId > 0) body['child_user_id'] = childUserId
  return requestJson('/api/talent/report', 'POST', body, null, true, LLM_TIMEOUT_MS)
}

/** JNAO 外部提交：answer 走 query，35 位 01 串 */
export function submitJnaoAnswer(answer: string): Promise<UTSJSONObject> {
  return requestJson('/api/talent/jnao/submit?answer=' + answer, 'POST')
}

export function getJnaoReport(recordId: string): Promise<UTSJSONObject> {
  return requestJson('/api/talent/jnao/report/' + recordId)
}

export function getTalentAssessment(assessmentId: number): Promise<UTSJSONObject> {
  return requestJson('/api/talent/assessment/' + assessmentId.toString())
}

export function listTalentHistory(): Promise<UTSJSONObject> {
  return requestJson('/api/talent/assessment/history')
}

export function getLatestTalentAssessment(): Promise<UTSJSONObject> {
  return requestJson('/api/talent/assessment/latest')
}

export function deleteTalentAssessment(assessmentId: number): Promise<UTSJSONObject> {
  return requestJson('/api/talent/assessment/' + assessmentId.toString(), 'DELETE')
}

export function prepareDayuTest(resultId: number): Promise<UTSJSONObject> {
  return requestJson('/api/talent/dayu-test/' + resultId.toString() + '/prepare')
}

/** 报告内历史问答 */
export function getTalentChatHistory(assessmentId: number): Promise<UTSJSONObject> {
  return requestJson('/api/talent/assessment/' + assessmentId.toString() + '/chat')
}

export function talentChat(assessmentId: number, content: string): Promise<UTSJSONObject> {
  const body: UTSJSONObject = { content: content }
  return requestJson(
    '/api/talent/assessment/' + assessmentId.toString() + '/chat',
    'POST',
    body,
    null,
    true,
    LLM_TIMEOUT_MS
  )
}

/** 流式天赋解答，done 事件带权威消息与 citations */
export function talentChatStream(
  assessmentId: number,
  content: string,
  sink: SseEventSink
): RequestTask | null {
  const body: UTSJSONObject = { content: content }
  return streamPost('/api/talent/assessment/' + assessmentId.toString() + '/chat/stream', body, sink)
}

/** 天赋报告里的属性列表；后端嵌在 results.Attribute.attributeList */
export function readReportAttributes(data: UTSJSONObject): Array<UTSJSONObject> {
  const results = data.getJSON<UTSJSONObject>('results')
  if (results == null) return []
  const attribute = results.getJSON<UTSJSONObject>('Attribute')
  if (attribute == null) return []
  return attribute.getArray<UTSJSONObject>('attributeList') ?? []
}
/** 天赋标签 → 报告页头像文件名 */
export function talentAvatarFile(talent: string): string {
  const map: UTSJSONObject = { '学者': 'study', '思者': 'think', '行者': 'act', '德者': 'virtue', '赢者': 'win' }
  return map.getString(talent) ?? 'study'
}
/* ---------- 报告对话 ----------
 * GET /api/talent/assessment/{id}/chat 返回（report_talent_agent.list_messages）：
 *   {opening, assessment_id, talent_primary, test_type, source_key,
 *    chips: [str], messages: [{role, content, citations}]}
 * 开场白不入库，由后端每次给出。
 */

export type TalentChatMessage = {
  role: string
  content: string
}

export type TalentChat = {
  opening: string
  assessmentId: number
  talentPrimary: string
  chips: string[]
  messages: TalentChatMessage[]
}

export function readTalentChat(data: UTSJSONObject): TalentChat {
  const raw = data.getArray<UTSJSONObject>('messages') ?? []
  const list: TalentChatMessage[] = []
  for (let i = 0; i < raw.length; i++) {
    const m = raw[i]
    list.push({
      role: m.getString('role') ?? '',
      content: m.getString('content') ?? ''
    })
  }
  return {
    opening: data.getString('opening') ?? '',
    assessmentId: data.getNumber('assessment_id') ?? 0,
    talentPrimary: data.getString('talent_primary') ?? '',
    chips: data.getArray<string>('chips') ?? [],
    messages: list
  }
}
