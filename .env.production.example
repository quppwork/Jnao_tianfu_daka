# 生产环境变量 — 复制为项目根目录 .env.production 后修改
# 宝塔部署: cp .env.production.example .env.production

# ── 站点域名（用于 CORS + 同域媒体缓存，填最终 HTTPS 地址）──
SITE_DOMAIN=https://jnaosoft.cn

# ── 阿里云 RDS MySQL（推荐：复用已有实例）──
# 密码含特殊字符时需 URL 编码，例如 ! → %21   @ → %40
# DATABASE_URL=mysql+pymysql://用户名:密码@rm-xxx.mysql.rds.aliyuncs.com:3306/库名

# 方案 A：在已有库里自动建本项目表（不删不改现有业务表）
DATABASE_URL=mysql+pymysql://jingnao:你的密码@rm-bp1lqyn1su17p6nr.mysql.rds.aliyuncs.com:3306/db_fz_jingnao

# 方案 B（更推荐）：同 RDS 实例下新建独立库，与业务数据隔离
# 在 DMS 执行: CREATE DATABASE jnao_daka CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# DATABASE_URL=mysql+pymysql://jingnao:你的密码@rm-bp1lqyn1su17p6nr.mysql.rds.aliyuncs.com:3306/jnao_daka

# ── 若无 RDS、改用 Docker 内置 MySQL 时填写 ──
# MYSQL_ROOT_PASSWORD=change-me-root-password
# MYSQL_USER=jnao
# MYSQL_PASSWORD=change-me-strong-password
# MYSQL_DATABASE=jnao_daka
# DATABASE_URL=mysql+pymysql://jnao:change-me-strong-password@mysql:3306/jnao_daka

# ── 豆包 AI（必填）──
DOUBAO_API_KEY=your-ark-api-key
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=doubao-seed-1-6-250615
DOUBAO_VISION_MODEL=doubao-seed-1-6-250615

# ── 阿里云 OSS（训练音频，按需填写）──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=jnao-talent-ai
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_PREFIX=yinpin/
# 阿里云 CDN 加速域（仅主机名，不含 https://）。控制台绑定 OSS 回源并解析 CNAME 后填写，例如 media.jnaosoft.cn
# OSS_CDN_DOMAIN=media.jnaosoft.cn

# ── 媒体播放（生产：CSP 已配 media-src 时用直跳 OSS，勿改宝塔 CSP）──
OSS_MEDIA_DIRECT_REDIRECT=1
OSS_MEDIA_SAME_ORIGIN_CACHE=0
# ⚠ 禁止 OSS_MEDIA_DIRECT_REDIRECT=0（同域缓存 SAME_ORIGIN 也只在 DIRECT=1 时生效）

# ── 语音服务（可选）──
SPEECH_APP_ID=
SPEECH_ACCESS_TOKEN=

# ── RAG 知识库 ──
# 旧本地 enterprise_rag（学科答疑遗留）；无内网服务时保持 MOCK=1
TIANFU_RAG_MOCK=1
TIANFU_RAG_URL=http://127.0.0.1:8010

# 阿里云百炼（引导页完整 RAG：Retrieve → 豆包生成）
# 服务器需能访问 bailian.cn-beijing.aliyuncs.com
BAILIAN_WORKSPACE_ID=ws-0w5t66cmzttowdnw
BAILIAN_API_HOST=ws-0w5t66cmzttowdnw.cn-beijing.maas.aliyuncs.com
BAILIAN_INDEX_ID=x1micrdmjq
GUIDE_RAG_ENABLED=1
GUIDE_RAG_MODE=retrieve
# 百炼直答（file_search 检索+生成，不经豆包）；0=Retrieve+豆包（推荐）
BAILIAN_RAG_GENERATE=0
BAILIAN_GENERATE_MODEL=qwen3.8-max
BAILIAN_GENERATE_TIMEOUT=25
BAILIAN_RAG_FALLBACK_DOUBAO=1
# 训练页：音视频知识库
BAILIAN_VIDEO_INDEX_ID=l37mx47k4u
TRAINING_RAG_ENABLED=1
# Search 模式才需要 DASHSCOPE_API_KEY；直答模式也需要
# DASHSCOPE_API_KEY=sk-ws-...
# BAILIAN_AGENT_ID=
# BAILIAN_RETRIEVE_TOP_N=3
# BAILIAN_ENABLE_RERANKING=1

# ── Redis（宝塔本机 Redis，Docker 经 host.docker.internal 访问）──
# 密码含 @ 等特殊字符需 URL 编码，如 @ → %40
REDIS_URL=redis://:你的密码@host.docker.internal:6379/0
QA_SESSION_CACHE_TTL=3600
CACHE_TTL_PROFILE=300
CACHE_TTL_ASSESSMENT=600
CACHE_TTL_TRAINING_TODAY=30
CACHE_TTL_TRAINING_PROGRESS=60
CACHE_TTL_GROWTH_SUMMARY=120
CACHE_TTL_ACHIEVEMENT=60
CACHE_TTL_GUIDE_BOOTSTRAP=86400

# ── 浏览器验证码短信（阿里云；微信绑手机走 WECHAT_BIND_MOBILE_URL）──
SMS_PROVIDER=aliyun
# ALIYUN_SMS_ACCESS_KEY_ID=          # 可省略，默认复用 OSS_ACCESS_KEY_*
# ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=杭州劲脑软件开发
ALIYUN_SMS_TEMPLATE_CODE=SMS_241225115
# Docker+Nginx 反代下按真实客户端 IP 限流（默认 30 次/小时/IP）
# SMS_HOURLY_PER_IP=30
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# ── 微信服务号（网页授权）──
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
# WECHAT_OAUTH_REDIRECT_URI=https://jnaosoft.cn/api/auth/wechat/callback
# LEGACY_DATABASE_URL=mysql+pymysql://用户:密码@主机:3306/db_fz_jingnao
# WECHAT_BIND_MOBILE_URL=https://m.jnao.com/home/member/bindmobile.html

# ── 运行模式 ──
JNAO_ENV=production
JNAO_DEV_MODE=0
JNAO_DEBUG_ROUTES=0

# ── 前端对外端口（仅本机监听，由宝塔 Nginx 反代）──
FRONTEND_HOST_PORT=5185
