<template>
  <view class="cb-row" :class="role == 'user' ? 'cb-row-user' : 'cb-row-ai'">
    <view class="cb-bubble" :class="role == 'user' ? 'cb-bubble-user' : 'cb-bubble-ai'">
      <text v-if="content.length > 0" class="cb-text">{{ content }}</text>
      <text v-if="pending && content.length == 0" class="cb-text cb-muted">正在思考…</text>
      <text v-if="pending && content.length > 0" class="cb-caret">▍</text>
    </view>
  </view>
</template>

<script setup lang="uts">
defineOptions({
  styleIsolation: 'app'
})

defineProps({
  role: {
    type: String,
    default: 'ai'
  },
  content: {
    type: String,
    default: ''
  },
  pending: {
    type: Boolean,
    default: false
  }
})
</script>

