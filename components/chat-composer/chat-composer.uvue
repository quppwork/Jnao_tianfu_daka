<template>
  <view class="cc-bar" :style="{ paddingBottom: inset > 0 ? inset + 'px' : '10px' }">
    <input
      v-model="draft"
      class="cc-input"
      :disabled="sending"
      :maxlength="maxlength"
      :placeholder="placeholder"
      placeholder-style="color:#5a6274"
      confirm-type="send"
      @confirm="submit"
    />
    <button v-if="sending" class="cc-btn cc-btn-stop" @click="doStop">
      <text class="cc-btn-text-stop">停止</text>
    </button>
    <button
      v-else
      class="cc-btn"
      :class="accent == 'gold' ? 'cc-btn-gold' : 'cc-btn-green'"
      :disabled="!canSend"
      @click="submit"
    >
      <text class="cc-btn-text">发送</text>
    </button>
  </view>
</template>

<script setup lang="uts">
defineOptions({
  styleIsolation: 'app'
})

const emit = defineEmits(['submit', 'stop'])

const props = defineProps({
  sending: {
    type: Boolean,
    default: false
  },
  placeholder: {
    type: String,
    default: '输入你的问题'
  },
  maxlength: {
    type: Number,
    default: 4000
  },
  inset: {
    type: Number,
    default: 0
  },
  accent: {
    type: String,
    default: 'green'
  }
})

const draft = ref('')

const canSend = computed(() => {
  return !props.sending && draft.value.trim().length > 0
})

function submit() {
  if (!canSend.value) return
  const text = draft.value.trim()
  if (text.length == 0) return
  draft.value = ''
  emit('submit', text)
}

function doStop() {
  emit('stop')
}
</script>

<style lang="scss" scoped>
@import '../../styles/dayu-theme.scss';

.cc-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-top: 10px;
  padding-left: 14px;
  padding-right: 14px;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: $dy-border;
  background-color: $dy-bg;
}

.cc-input {
  flex: 1;
  height: 40px;
  padding-left: 14px;
  padding-right: 14px;
  margin-right: 10px;
  border-radius: 20px;
  border-width: 1px;
  border-style: solid;
  border-color: $dy-border-soft;
  background-color: $dy-card;
  color: $dy-text;
  font-size: 14px;
}

.cc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68px;
  height: 40px;
  border-radius: 20px;
  padding: 0;
  margin: 0;
}

.cc-btn-green {
  background-color: $dy-green;
}

.cc-btn-gold {
  background-color: $dy-gold;
}

.cc-btn-stop {
  background-color: $dy-danger;
}

.cc-btn-text {
  color: $dy-bg;
  font-size: 14px;
  font-weight: 700;
}

.cc-btn-text-stop {
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
}
</style>
