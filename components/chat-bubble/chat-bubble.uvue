<template>
  <view class="cb-row" :class="role == 'user' ? 'cb-row-user' : 'cb-row-ai'">
    <image
      v-if="role != 'user'"
      class="cb-avatar"
      :class="accent == 'gold' ? 'cb-avatar-gold' : 'cb-avatar-green'"
      src="/static/dayu/avatar_sizhe.jpg"
      mode="aspectFill"
    />
    <view
      class="cb-bubble"
      :class="role == 'user' ? (accent == 'gold' ? 'cb-bubble-user-gold' : 'cb-bubble-user-green') : 'cb-bubble-ai'"
    >
      <text
        v-if="content.length > 0"
        class="cb-text"
        :class="role == 'user' ? 'cb-text-user' : ''"
      >{{ content }}</text>
      <text v-if="pending && content.length == 0" class="cb-text cb-muted">正在思考…</text>
      <text
        v-if="pending && content.length > 0"
        class="cb-caret"
        :class="accent == 'gold' ? 'cb-caret-gold' : 'cb-caret-green'"
      >▍</text>
    </view>
  </view>
</template>

<script setup lang="uts">
defineOptions({
  styleIsolation: 'app'
})

defineProps({
  role: {
    type: String,
    default: 'ai'
  },
  content: {
    type: String,
    default: ''
  },
  pending: {
    type: Boolean,
    default: false
  },
  accent: {
    type: String,
    default: 'green'
  }
})
</script>

