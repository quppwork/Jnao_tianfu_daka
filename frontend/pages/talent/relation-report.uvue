<template>
  <view class="rr-page">
    <view class="top" :style="{ marginTop: topInset + 'px' }">
      <view class="back" @click="goBack"><text class="back-icon">‹</text></view>
      <text class="top-title">关系合测报告</text>
      <view class="spacer"></view>
    </view>
    <scroll-view class="scroll" direction="vertical">
      <view class="body">
        <view v-if="loading" class="card"><text class="dim">正在读取关系报告…</text></view>
        <view v-else-if="errorText.length > 0" class="card">
          <text class="error">{{ errorText }}</text>
          <button class="secondary" @click="loadDetail">重试</button>
        </view>

        <view v-else-if="detail != null">
          <view class="hero">
            <view class="pair-row">
              <view class="pair-side">
                <text class="pair-name">{{ detail.myUser.nickname.length > 0 ? detail.myUser.nickname : '我' }}</text>
                <text class="pair-talent">{{ detail.myTalent }}</text>
              </view>
              <view class="pair-mid">
                <text class="pair-rela">{{ detail.relaText }}</text>
              </view>
              <view class="pair-side">
                <text class="pair-name">{{ detail.friendUser.nickname.length > 0 ? detail.friendUser.nickname : '对方' }}</text>
                <text class="pair-talent">{{ detail.friendTalent }}</text>
              </view>
            </view>
            <text class="score-big">{{ detail.score }}%</text>
            <text v-if="detail.tag.length > 0" class="score-tag">{{ detail.tag }}</text>
            <text v-if="detail.createdAt.length > 0" class="dim">{{ detail.createdAt }}</text>
          </view>

          <view v-for="(dim, idx) in detail.dims" :key="idx" class="card">
            <view class="dim-head">
              <text class="dim-title">{{ dim.name }}</text>
              <text class="dim-score">{{ dim.value }}%</text>
            </view>
            <view class="track">
              <view class="fill" :style="{ width: Math.min(100, dim.value) + '%' }"></view>
            </view>

            <view v-if="dim.despLines.length > 0" class="short-box">
              <text v-for="(line, li) in dim.despLines" :key="'d' + li" class="short-line">{{ line }}</text>
            </view>

            <view v-for="(sec, si) in dim.sections" :key="'s' + si" class="sec-block">
              <text v-if="sec.title.length > 0" class="sec-title">{{ sec.title }}</text>
              <text v-for="(sl, sli) in sec.lines" :key="'sl' + sli" class="sec-line">{{ sl }}</text>
            </view>
          </view>

          <button class="secondary" @click="goBack">返回</button>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { getRelationReport } from '../../api/talent.uts'
import { parseRelationReportDetail } from '../../api/talent-parsers.uts'
import { RelationReportDetail } from '../../api/talent-types.uts'
import { getPageTopInset } from '../../utils/layout.uts'

const topInset = ref(0)
const relationId = ref(0)
const loading = ref(false)
const errorText = ref('')
const detail = ref<RelationReportDetail | null>(null)

async function loadDetail() {
  if (loading.value || relationId.value <= 0) return
  loading.value = true
  errorText.value = ''
  try {
    const resp = await getRelationReport(relationId.value)
    detail.value = parseRelationReportDetail(resp)
  } catch (error) {
    errorText.value = error instanceof Error ? error.message : '读取关系报告失败'
  } finally {
    loading.value = false
  }
}

function goBack() {
  uni.navigateBack()
}

onLoad((options) => {
  const rid = parseInt(options['id'] ?? '')
  if (!isNaN(rid) && rid > 0) {
    relationId.value = rid
    loadDetail()
  } else {
    errorText.value = '缺少关系报告编号'
  }
})

onReady(() => {
  topInset.value = getPageTopInset()
})
</script>

<style lang="scss" scoped>
@import './relation-report.scss';
</style>
