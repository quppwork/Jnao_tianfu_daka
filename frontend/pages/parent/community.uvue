<template>
  <view class="cm-page">
    <view class="cm-header" :style="{ paddingTop: insetTop + 'px' }">
      <view class="cm-brand">
        <text class="cm-title">天赋社区</text>
        <text class="cm-sub">COMMUNITY · 家长同行成长圈</text>
      </view>
      <view class="cm-chip" @click="openConsult">
        <text class="cm-chip-text">问导师</text>
      </view>
    </view>

    <scroll-view class="cm-body" scroll-y :show-scrollbar="false">
      <!-- 暖金助力卡 -->
      <view class="cm-rank-card">
        <view class="cm-rank-head">
          <text class="cm-rank-title">🏆 天赋成长同行榜</text>
          <text class="cm-rank-meta">本周活跃家长圈</text>
        </view>
        <text class="cm-rank-sub">
          陪孩子坚持每日修炼，记录每一次微小进步。分享你的育儿观察，与同天赋家长交流心得。
        </text>
        <view class="cm-rank-actions">
          <view class="cm-gold-btn" @click="openCourse">
            <text class="cm-gold-btn-text">看家长课堂</text>
          </view>
          <view class="cm-ghost-btn" @click="openData">
            <text class="cm-ghost-btn-text">看孩子数据</text>
          </view>
        </view>
      </view>

      <!-- 精选动态 -->
      <view class="cm-sec-head">
        <text class="cm-sec-title">精选成长分享</text>
      </view>

      <view v-for="(post, idx) in posts" :key="idx.toString()" class="cm-post">
        <view class="cm-post-top">
          <view class="cm-post-badge">
            <text class="cm-post-badge-text">{{ post.talent }}</text>
          </view>
          <view class="cm-post-meta">
            <text class="cm-post-author">{{ post.author }}</text>
            <text class="cm-post-time">{{ post.meta }}</text>
          </view>
        </view>
        <text class="cm-post-text">{{ post.content }}</text>
        <view class="cm-post-foot">
          <text class="cm-post-tag">{{ post.tag }}</text>
          <view class="cm-like" @click="toggleLike(idx)">
            <text class="cm-like-text" :class="post.liked ? 'cm-like-on' : ''">
              {{ post.liked ? '♥ ' : '♡ ' }}{{ post.likes }}
            </text>
          </view>
        </view>
      </view>

      <view class="cm-space"></view>
    </scroll-view>

    <dayu-tab-bar role="parent" active="community" />
  </view>
</template>

<script setup lang="uts">
import { getSession, returnToLogin } from '../../state/session.uts'
import { getPageTopInset } from '../../utils/layout.uts'

const insetTop = ref(0)
const posts = ref([
  {
    talent: '思者',
    author: '乐乐妈妈 · 初一',
    meta: '坚持今日修炼第 21 天',
    content: '以前催写作业天天鸡飞狗跳，按大宇建议把 20 分钟修炼放到晚饭后固定时段，这周孩子自己主动打开打卡，专注度明显提上来了。',
    tag: '#习惯养成',
    likes: 36,
    liked: false
  },
  {
    talent: '学者',
    author: '轩轩爸爸 · 五年级',
    meta: '家长课堂已学 14 讲',
    content: '听完家长课堂关于“学者天赋”的拆解才明白，孩子不是磨蹭，而是喜欢把底层原理想透。现在少催多问，他反而效率翻倍。',
    tag: '#家长课堂笔记',
    likes: 28,
    liked: false
  },
  {
    talent: '行者',
    author: '朵朵妈妈 · 初二',
    meta: '连续打卡 12 天',
    content: '数学卡壳的题以前直接看答案，现在用学科答疑让余峰老师一步步追问，昨天自己推出辅助线开心坏了。',
    tag: '#学科答疑心得',
    likes: 42,
    liked: false
  }
])

function toggleLike(idx: number) {
  const list = posts.value.slice(0)
  const item = list[idx]
  item.liked = !item.liked
  item.likes = item.liked ? item.likes + 1 : item.likes - 1
  posts.value = list
}

function openConsult() {
  uni.redirectTo({ url: '/pages/parent/consult' })
}

function openCourse() {
  uni.navigateTo({ url: '/pages/parent/pcourse' })
}

function openData() {
  uni.redirectTo({ url: '/pages/parent/pdata' })
}

onLoad(() => {
  if (getSession() == null) {
    returnToLogin()
  }
})

onReady(() => {
  insetTop.value = getPageTopInset()
})
</script>

