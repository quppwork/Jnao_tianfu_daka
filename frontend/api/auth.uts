import { requestJson } from '../network/request.uts'
import { applySessionView, clearSession, getSession, saveSession } from '../state/session.uts'

function getDeviceId(): string {
  const key = 'jnao_device_id'
  const stored = uni.getStorageSync(key)
  if (typeof stored == 'string' && stored.length > 0) return stored
  const id = 'd_' + Date.now().toString() + '_' + Math.floor(Math.random() * 1000000000).toString()
  uni.setStorageSync(key, id)
  return id
}

export type StudentRegisterPayload = {
  loginName: string
  password: string
  realName: string
  nickname: string
  birthDate: string
  grade: string
  school: string
  region: string
  captchaId: string
  captchaCode: string
  remember: boolean
}

export function getLoginCaptcha(): Promise<UTSJSONObject> {
  return requestJson('/api/t2/auth/captcha', 'GET', null, null, false)
}

export function sendAuthSms(phone: string, scene: string, captchaId: string, captchaCode: string): Promise<UTSJSONObject> {
  return requestJson('/api/auth/sms/send', 'POST', {
    phone,
    scene,
    captcha_id: captchaId,
    captcha_code: captchaCode,
    device_id: getDeviceId()
  }, null, scene == 'phone_change')
}

export async function registerParent(
  phone: string,
  code: string,
  realName: string,
  nickname: string,
  password: string,
  remember: boolean = false
) {
  const data = await requestJson('/api/auth/sms/register', 'POST', {
    phone,
    sms_code: code,
    real_name: realName,
    nickname,
    password,
    remember,
    device_id: getDeviceId()
  }, null, false)
  useLoginResponse(data, 'parent')
}

export async function registerStudent(payload: StudentRegisterPayload) {
  const body: UTSJSONObject = {
    login_name: payload.loginName.trim().toLowerCase(),
    password: payload.password,
    real_name: payload.realName.trim(),
    birth_date: payload.birthDate.trim(),
    captcha_id: payload.captchaId,
    captcha_code: payload.captchaCode.trim(),
    remember: payload.remember,
    device_id: getDeviceId()
  }
  if (payload.nickname.trim().length > 0) body['nickname'] = payload.nickname.trim()
  if (payload.grade.trim().length > 0) body['grade'] = payload.grade.trim()
  if (payload.school.trim().length > 0) body['school'] = payload.school.trim()
  if (payload.region.trim().length > 0) body['region'] = payload.region.trim()
  const data = await requestJson('/api/t2/auth/register/student', 'POST', body, null, false)
  const authObj = data.getJSON('auth') ?? data
  const sessionObj = data.getJSON('session') ?? data
  useLoginResponse(authObj, 'student', sessionObj)
}

export async function loginWithSms(phone: string, code: string, remember: boolean = false) {
  const query = remember ? '?remember=true' : '?remember=false'
  const data = await requestJson('/api/t2/auth/sms/login' + query, 'POST', {
    phone,
    sms_code: code,
    device_id: getDeviceId()
  }, null, false)
  useLoginResponse(data, 'parent')
}

export async function loginWithPassword(
  role: string,
  account: string,
  password: string,
  remember: boolean = false
) {
  const body: UTSJSONObject = { password, role }
  if (role == 'parent') {
    body['parent_phone'] = account
  } else {
    body['login_name'] = account.trim().toLowerCase()
  }
  const headers: UTSJSONObject = {
    'X-Device-Id': getDeviceId()
  }
  const query = remember ? '?remember=true' : '?remember=false'
  const data = await requestJson('/api/t2/auth/login' + query, 'POST', body, headers, false)
  useLoginResponse(data, role)
}

function useLoginResponse(data: UTSJSONObject, role: string, sessionView: UTSJSONObject | null = null) {
  const userId = data.getNumber('child_user_id') ?? data.getNumber('account.id') ?? 0
  const actualRole = data.getString('role') ?? data.getString('account.role') ?? ''
  const accessToken = data.getString('access_token') ?? data.getString('session_token') ?? ''
  if (actualRole != role || userId <= 0) {
    throw new Error('登录响应中的账号身份无效')
  }
  // #ifndef WEB
  // App / 小程序端不共享浏览器 HttpOnly Cookie，空 token 会导致后续请求立刻 401 踢回登录页。
  if (accessToken.length == 0) {
    throw new Error('服务端未返回登录凭证，请确认后端已开启移动端 token 返回')
  }
  // #endif
  saveSession({
    userId,
    role,
    nickname: data.getString('nickname') ?? data.getString('account.display_name') ?? '',
    accessToken
  })
  applySessionView(sessionView ?? data)
}

export function fetchSession(): Promise<UTSJSONObject> {
  return requestJson('/api/t2/auth/session', 'GET')
}

export function selectSessionProfile(activeChildId: number | null): Promise<UTSJSONObject> {
  return requestJson('/api/t2/auth/session/profile', 'PATCH', {
    active_child_id: activeChildId
  })
}

export function createGuardianCode(): Promise<UTSJSONObject> {
  return requestJson('/api/t2/auth/guardian-codes', 'POST')
}

export function bindGuardian(code: string): Promise<UTSJSONObject> {
  return requestJson('/api/t2/auth/guardian-links', 'POST', { code })
}

export function unbindMyGuardian(): Promise<UTSJSONObject> {
  return requestJson('/api/t2/auth/guardian-links/me', 'DELETE')
}

export function unbindGuardian(childId: number): Promise<UTSJSONObject> {
  return requestJson('/api/t2/auth/guardian-links/' + childId.toString(), 'DELETE')
}

export function resetPassword(phone: string, smsCode: string, newPassword: string): Promise<UTSJSONObject> {
  return requestJson('/api/t2/auth/password/reset', 'POST', {
    phone: phone.trim(),
    sms_code: smsCode.trim(),
    new_password: newPassword,
    device_id: getDeviceId()
  }, null, false)
}

function applyRotatedToken(data: UTSJSONObject) {
  const session = getSession()
  if (session == null) return
  const nextToken = data.getString('access_token') ?? data.getString('session_token') ?? ''
  const nextNick = data.getString('nickname') ?? data.getString('account.display_name') ?? ''
  if (nextToken.length > 0 || (nextNick.length > 0 && nextNick != session.nickname)) {
    saveSession({
      userId: session.userId,
      role: session.role,
      nickname: nextNick.length > 0 ? nextNick : session.nickname,
      accessToken: nextToken.length > 0 ? nextToken : session.accessToken
    })
  }
  applySessionView(data)
}

export async function changePassword(oldPassword: string, newPassword: string): Promise<UTSJSONObject> {
  const data = await requestJson('/api/t2/auth/change-password', 'POST', {
    old_password: oldPassword,
    new_password: newPassword
  })
  applyRotatedToken(data)
  return data
}

export async function changePhone(
  currentPassword: string,
  newPhone: string,
  smsCode: string
): Promise<UTSJSONObject> {
  const data = await requestJson('/api/t2/auth/phone/change', 'POST', {
    current_password: currentPassword,
    new_phone: newPhone.trim(),
    sms_code: smsCode.trim()
  })
  applyRotatedToken(data)
  return data
}

export async function logout() {
  try {
    await requestJson('/api/t2/auth/logout', 'POST')
  } finally {
    clearSession()
  }
}

/* ---------- 微信登录子流程 ----------
 * 后端契约（api/auth.py）：
 *   GET  /wechat/config                              → {app_id, bind_mobile_return_url, ...}
 *   GET  /wechat/exchange?login_ticket=xxx           → AuthResponse（H5 OAuth 回调后换取）
 *   POST /wechat/send-bind-sms  {bind_ticket, phone, captcha_id, image_base64, device_id?}
 *   POST /wechat/bind-phone     {bind_ticket, phone, sms_code, device_id?}
 */

export function getWechatConfig(): Promise<UTSJSONObject> {
  return requestJson('/api/auth/wechat/config', 'GET', null, null, false)
}

export function wechatExchange(loginTicket: string): Promise<UTSJSONObject> {
  return requestJson('/api/auth/wechat/exchange?login_ticket=' + encodeURIComponent(loginTicket), 'GET', null, null, false)
}

/** 发绑定短信：需要图形验证码，imageBase64 是 /auth/captcha 返回的裸 base64（不带 data: 前缀） */
export function wechatSendBindSms(
  bindTicket: string,
  phone: string,
  captchaId: string,
  imageBase64: string
): Promise<UTSJSONObject> {
  const body: UTSJSONObject = {
    bind_ticket: bindTicket,
    phone: phone,
    captcha_id: captchaId,
    image_base64: imageBase64
  }
  return requestJson('/api/auth/wechat/send-bind-sms', 'POST', body, null, false)
}

export function wechatBindPhone(bindTicket: string, phone: string, smsCode: string): Promise<UTSJSONObject> {
  const body: UTSJSONObject = {
    bind_ticket: bindTicket,
    phone: phone,
    sms_code: smsCode
  }
  return requestJson('/api/auth/wechat/bind-phone', 'POST', body, null, false)
}
