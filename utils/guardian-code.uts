const GUARDIAN_CODE_PATTERN = /^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{8}$/

export function normalizeGuardianCode(raw: string): string {
  return raw.replace(/[\s\-·•_]/g, '').toUpperCase()
}

export function isGuardianCodeValid(raw: string): boolean {
  return GUARDIAN_CODE_PATTERN.test(normalizeGuardianCode(raw))
}

export function formatGuardianCode(raw: string): string {
  const clean = normalizeGuardianCode(raw)
  if (clean.length <= 4) return clean
  return clean.substring(0, 4) + ' · ' + clean.substring(4)
}

export function generateRequestId(): string {
  const hex = '0123456789abcdef'
  let out = ''
  for (let i = 0; i < 36; i++) {
    if (i == 8 || i == 13 || i == 18 || i == 23) {
      out += '-'
    } else if (i == 14) {
      out += '4'
    } else if (i == 19) {
      out += hex.charAt(8 + Math.floor(Math.random() * 4))
    } else {
      out += hex.charAt(Math.floor(Math.random() * 16))
    }
  }
  return out
}
