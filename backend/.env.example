# JNAO Backend — 环境变量
# 复制此文件为 .env 并填入真实值

# DeepSeek（备用模型）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 豆包（火山引擎 Ark）
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=your-ark-api-key
# 使用 Ark /models 返回的完整 model id，或控制台推理接入点 ep-xxxx
DOUBAO_CHAT_MODEL=doubao-seed-1-6-250615
# 拍图识题可与文本模型相同（需支持 vision 的模型 id）
DOUBAO_VISION_MODEL=doubao-seed-1-6-250615

# D:\11 enterprise_rag 知识库（学科教学法）；本地无服务时设 TIANFU_RAG_MOCK=1
TIANFU_RAG_URL=http://127.0.0.1:8010
RAG_API_SECRET=

# 火山引擎语音服务（TTS/ASR，需单独申请）
SPEECH_APP_ID=
SPEECH_ACCESS_TOKEN=

# MySQL（生产）或留空使用 SQLite 本地库
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/jnao_daka
# DATABASE_URL=sqlite:///./data/jnao_daka.db

# 本地开发：跳过内网 tianfu_rag 探测（health 不再等 3 秒）
TIANFU_RAG_MOCK=1

# 运行环境：development（默认）| production
JNAO_ENV=development

# 开发者 API（/api/dev/*）；生产必须设为 0
JNAO_DEV_MODE=1

# 调试路由与 /docs OpenAPI；生产默认关，需排查时可设 1
JNAO_DEBUG_ROUTES=1

# 短信验证码 — 浏览器家长登录/注册（暂 mock；后期单独接阿里云，与微信绑手机无关）
SMS_PROVIDER=mock
SMS_MOCK_CODE=88888
AUTH_CHALLENGE_MOCK=1
# 后期: SMS_PROVIDER=aliyun + ALIYUN_SMS_*（见 docs/微信与家长登录方案.md §8.3）

# 微信服务号 OAuth
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
# 缺手机号时跳转公司绑手机页（默认 m.jnao.com）
WECHAT_BIND_MOBILE_URL=https://m.jnao.com/home/member/bindmobile.html
# WECHAT_BIND_MOBILE_RETURN_PARAM=redirect
# WECHAT_BIND_MOBILE_RETURN_URL=https://jnaosoft.cn/pages/login/index?from=mp
# LEGACY_DATABASE_URL=mysql+pymysql://...@.../db_fz_jingnao
# COMPANY_SMS_BASE_URL=

# 前端 CORS 白名单（逗号分隔）；留空则用本地 5185-5187
# CORS_ORIGINS=http://127.0.0.1:5185,http://localhost:5185

# 阿里云 OSS（只读：训练音频/视频目录列举与签名播放；用户数据不上传 OSS）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=jnao-talent-ai
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_PREFIX=yinpin/
OSS_SIGNED_URL=true
OSS_SIGN_EXPIRES=7200
