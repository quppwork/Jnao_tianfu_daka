# JNAO Backend — 环境变量
# 复制此文件为 .env 并填入真实值

# DeepSeek（备用模型）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 豆包（火山引擎 Ark）
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=your-ark-api-key
# 使用 Ark /models 返回的完整 model id，或控制台推理接入点 ep-xxxx
DOUBAO_CHAT_MODEL=doubao-seed-1-6-250615
# 拍图识题可与文本模型相同（需支持 vision 的模型 id）
DOUBAO_VISION_MODEL=doubao-seed-1-6-250615

# D:\11 enterprise_rag 知识库（学科教学法）；本地无服务时设 TIANFU_RAG_MOCK=1
TIANFU_RAG_URL=http://127.0.0.1:8010
RAG_API_SECRET=

# 阿里云百炼知识库（完整 RAG：Retrieve/Search → 豆包）
# 架构说明见 docs/百炼知识库-完整RAG架构.md
# BAILIAN_WORKSPACE_ID=ws-xxxxxxxx
# BAILIAN_API_HOST=ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com
# BAILIAN_INDEX_ID=
# DASHSCOPE_API_KEY=                 # Search 多库时用
# BAILIAN_AGENT_ID=                  # Search：控制台发布知识检索 Agent
# GUIDE_RAG_ENABLED=0
# GUIDE_RAG_MODE=retrieve            # retrieve | search
# BAILIAN_RETRIEVE_TOP_N=3
# BAILIAN_DENSE_TOP_K=6
# BAILIAN_ENABLE_RERANKING=1
# BAILIAN_ENABLE_REWRITE=0
# ALIBABA_CLOUD_ACCESS_KEY_ID=       # 可省略，默认复用 OSS_ACCESS_KEY_ID
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 火山引擎语音服务（TTS/ASR，需单独申请）
SPEECH_APP_ID=
SPEECH_ACCESS_TOKEN=

# MySQL（生产）或留空使用 SQLite 本地库
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/jnao_daka
# DATABASE_URL=sqlite:///./data/jnao_daka.db

# 本地开发：跳过内网 tianfu_rag 探测（health 不再等 3 秒）
TIANFU_RAG_MOCK=1

# Session Cookie（V-04）：HttpOnly 存储 token，前端 credentials: include
SESSION_USE_HTTPONLY_COOKIE=1
# 生产勿开启；仅测试/调试时在 JSON 中返回 session_token
SESSION_EXPOSE_TOKEN_IN_JSON=0
# 本地 http 开发可设 0；生产 HTTPS 自动 Secure
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=lax


# 开发态：后端进程重启后前端强制重新登录（生产默认 0，勿开）
# JNAO_DEV_FORCE_RELOGIN=1

# 开发者 API（/api/dev/*）；生产必须设为 0
JNAO_DEV_MODE=1

# 调试路由与 /docs OpenAPI；生产默认关，需排查时可设 1
JNAO_DEBUG_ROUTES=1

# 短信验证码 — 浏览器家长登录/注册（与微信绑手机无关）
SMS_PROVIDER=mock
SMS_MOCK_CODE=88888
AUTH_CHALLENGE_MOCK=1
# 生产: SMS_PROVIDER=aliyun
# ALIYUN_SMS_ACCESS_KEY_ID=          # 可省略，默认复用 OSS_ACCESS_KEY_*
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=杭州劲脑软件开发
# ALIYUN_SMS_TEMPLATE_CODE=SMS_241225115

# 微信服务号 OAuth
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
# 缺手机号时跳转公司绑手机页（默认 m.jnao.com）
WECHAT_BIND_MOBILE_URL=https://m.jnao.com/home/member/bindmobile.html
# WECHAT_BIND_MOBILE_RETURN_PARAM=redirect
# WECHAT_BIND_MOBILE_RETURN_URL=https://jnaosoft.cn/pages/login/index?from=mp
# LEGACY_DATABASE_URL=mysql+pymysql://...@.../db_fz_jingnao
# COMPANY_SMS_BASE_URL=

# 企业微信客户联系（tools/sync_wework_served_contacts.py）
# WEWORK_CORPID=
# WEWORK_CORPSECRET=
# WEWORK_AGENTID=

# 前端 CORS 白名单（逗号分隔）；留空则用本地 5185-5187
# CORS_ORIGINS=http://127.0.0.1:5185,http://localhost:5185

# 反向代理后取真实客户端 IP；仅当直连 IP 在此列表内才信任 X-Forwarded-For（B9）
# TRUSTED_PROXY_IPS=127.0.0.1,::1,10.0.0.1

# 管理员账号（必填；生产密码至少 16 位，启动时会同步到数据库）
ADMIN_LOGIN_NAME=
ADMIN_PASSWORD=

# 发版热更新：前端轮询 /api/meta/version 对比 build_id
# JNAO_APP_VERSION=0.3.0
# JNAO_BUILD_ID=20260723-001

# 维护模式（部署窗口）：前端全屏提示，ping.ok=false
# JNAO_MAINTENANCE=1
# JNAO_MAINTENANCE_MSG=系统升级中，预计 10 分钟恢复

# 不兼容发版时置 1：前端清本地登录（发版完成后务必改回 0）
# JNAO_FORCE_LOGOUT=0

# 首页 Guide 对话限流（按 child_user_id；chat + stream 合计）
# GUIDE_CHAT_RATE_LIMIT=1
# GUIDE_CHAT_QPS_MAX=10
# GUIDE_CHAT_QPS_WINDOW_SEC=60
# GUIDE_CHAT_DAY_MAX=150

# 学科答疑对话限流（与 Guide 分桶；chat + stream 合计）
# QA_CHAT_RATE_LIMIT=1
# QA_CHAT_QPS_MAX=10
# QA_CHAT_QPS_WINDOW_SEC=60
# QA_CHAT_DAY_MAX=150

# 首页 Guide 主动节奏（bootstrap 进页一句：掉队/连打/周简报）
# GUIDE_PROACTIVE_ENABLED=1
# GUIDE_PROACTIVE_WEEKLY=1
# GUIDE_PROACTIVE_STREAK_MILESTONES=3,7,14,21,30

# 首页 Guide 个性化策略（按天赋/弱项/情境注入短策略；0=关闭）
# GUIDE_STRATEGY_ENABLED=1

# 学科答疑短策略（按天赋/学段注入；0=关闭）
# QA_STRATEGY_ENABLED=1

# 阿里云 OSS（只读：训练音频/视频目录列举与签名播放；用户数据不上传 OSS）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=jnao-talent-ai
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_PREFIX=yinpin/
OSS_SIGNED_URL=true
OSS_SIGN_EXPIRES=7200
# OSS_MEDIA_DIRECT_REDIRECT=1
# OSS_MEDIA_SAME_ORIGIN_CACHE=0   # CSP 已配 media-src 时用 0（直跳 OSS）；1=同域缓存（备选）
# SITE_DOMAIN=https://jnaosoft.cn
