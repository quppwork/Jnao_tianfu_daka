# 宝塔面板 → 网站 → jnaosoft.cn → 反向代理（或 配置文件）
# 关键：CSP 必须写在 location / 里，不能只写在 server { } 顶层！
# 原因：location 里一旦有 add_header / 反代，server 级的 add_header 不会继承到 HTML 响应。
#
# 生产（jnaosoft.cn）：CSP 已在宝塔 location / 配好 media-src 含 OSS 域名时，用直跳 OSS：
#   OSS_MEDIA_DIRECT_REDIRECT=1  +  OSS_MEDIA_SAME_ORIGIN_CACHE=0
# 同域 /api/media/oss/ 缓存为备选（CSP 未改好时），见 docs/运维与发版.md
#
# 编辑文件（二选一）：
#   /www/server/panel/vhost/nginx/proxy/jnaosoft.cn/*.conf
# 或在主配置里替换 location / 段。
#
# 前提：docker compose 已启动，前端监听 127.0.0.1:5185

location / {
    proxy_pass http://127.0.0.1:5185;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    client_max_body_size 20m;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # ── 安全头 + CSP：必须在此 location 内，OSS 直链需 media-src ──
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: data: https://jnao-talent-ai.oss-cn-beijing.aliyuncs.com; connect-src 'self' https://jnaosoft.cn wss://jnaosoft.cn; font-src 'self' data:; frame-ancestors 'self';" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
}

# 若 server { } 顶层也有同名 add_header，请删掉顶层的 CSP/安全头，避免重复且互相覆盖。
# 检查 extension 目录是否还有第二条 CSP：
#   ls /www/server/panel/vhost/nginx/extension/jnaosoft.cn/
#
# 验证：
#   curl -sI https://jnaosoft.cn/ | grep -i content-security
# 应只有一行，且含 media-src 与 oss-cn-beijing.aliyuncs.com
