FROM nginx:1.27-alpine

RUN apk add --no-cache gettext \
    && mkdir -p /var/cache/nginx/media \
    && rm -f /usr/share/nginx/html/index.html

COPY docker/nginx-main.conf /etc/nginx/nginx.conf
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY docker/docker-entrypoint-nginx.sh /docker-entrypoint-nginx.sh
RUN sed -i 's/\r$//' /docker-entrypoint-nginx.sh \
    && chmod +x /docker-entrypoint-nginx.sh

COPY vue_fronted/src/static/ /usr/share/nginx/html/static/
COPY vue_fronted/src/static/MP_verify_aRhvQC5V4c6H9PYQ.txt /usr/share/nginx/html/

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint-nginx.sh"]
